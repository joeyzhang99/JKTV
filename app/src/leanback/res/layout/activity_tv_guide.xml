<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131619"
    android:orientation="vertical">

    <!-- 上方：预览窗 + 当前节目信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="274dp"
        android:orientation="horizontal"
        android:paddingStart="26dp"
        android:paddingTop="18dp"
        android:paddingEnd="26dp"
        android:paddingBottom="6dp">

        <!-- 预览窗（显示当前频道台标；后续可接实时画面） -->
        <FrameLayout
            android:id="@+id/previewBox"
            android:layout_width="422dp"
            android:layout_height="252dp"
            android:background="@drawable/bg_guide_preview">

            <ImageView
                android:id="@+id/previewLogo"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/previewNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="10dp"
                android:textColor="#B9C0C8"
                android:textSize="14sp"
                tools:text="020" />
        </FrameLayout>

        <!-- 节目信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="26dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9AA3AD"
                android:textSize="15sp"
                tools:text="凤凰资讯" />

            <TextView
                android:id="@+id/programTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#EDF1F7"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="无信息" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/programTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#E6EAEF"
                    android:textSize="16sp"
                    tools:text="19:00 - 20:00" />

                <ProgressBar
                    android:id="@+id/programProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="35"
                    android:progressTint="#DEE0E2"
                    android:progressBackgroundTint="#3A3D3F" />

                <TextView
                    android:id="@+id/programRemain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9AA3AD"
                    android:textSize="15sp"
                    tools:text="47 分钟" />
            </LinearLayout>

            <TextView
                android:id="@+id/programDesc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:maxLines="4"
                android:textColor="#8A9096"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 右上：分组名 -->
        <TextView
            android:id="@+id/groupName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#9AA3AD"
            android:textSize="15sp"
            tools:text="香港" />
    </LinearLayout>

    <com.fongmi.android.tv.ui.custom.TimeRulerView
        android:id="@+id/ruler"
        android:layout_width="match_parent"
        android:layout_height="34dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</LinearLayout>
